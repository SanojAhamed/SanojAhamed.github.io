{
  "$schema": "https://angular.io/cli/schema/angular-json",
  "version": 1,
  "projects": {
    "sanoj-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/sanoj-angular",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              { "glob": "**/*", "input": "src/assets", "output": "/assets" },
              { "glob": "**/*", "input": "src/file",   "output": "/file" }
            ],
            "styles": [
              "src/assets/css/bootstrap.min.css",
              "src/assets/css/style.css",
              "src/assets/css/my.css",
              "src/assets/css/contact.css",
              "src/assets/css/load.css"
            ],
            "scripts": [
              "src/assets/js/bootstrap.bundle.min.js",
              "src/assets/js/particles.js",
              "src/assets/js/app.js",
              "src/assets/js/script.js"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "sanoj-angular:build"
          }
        },
        "deploy": {
          "builder": "angular-cli-ghpages:deploy"
        }
      }
    }
  },
  "cli": { "analytics": false }
}